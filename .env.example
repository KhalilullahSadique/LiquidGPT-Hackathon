# Copy this file to `.env` and fill in at least one key, then restart the dev server.
#
#   cp .env.example .env
#
# These are SERVER-side variables, read only by the /api/chat serverless function.
# They deliberately have no VITE_ prefix: Vite inlines every VITE_-prefixed variable into
# the browser bundle, which is exactly how an API key ends up public. Without the prefix
# the key never reaches the client.
#
# NEVER put a real key in this file. It is committed to the repo on purpose, so that
# contributors can see which variable names they need.

# Primary provider. Free tier, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback, used automatically when Gemini fails: https://openrouter.ai/keys
OPENROUTER_API_KEY=
